SFI_ENV=development
SFI_APP_NAME=Sistema Financeiro Inteligente
SFI_API_PREFIX=/api/v1
SFI_CORS_ORIGINS=http://localhost:5173
# Neon connection string; backend only. Never expose it to the browser.
SFI_DATABASE_URL=
# Generate a random secret of at least 32 characters; never commit the real value.
SFI_JWT_SECRET_KEY=
SFI_JWT_ALGORITHM=HS256
SFI_ACCESS_TOKEN_MINUTES=20
SFI_REFRESH_TOKEN_DAYS=30
# Keep false for local HTTP; production must use HTTPS and set true.
SFI_REFRESH_COOKIE_SECURE=false
# Use "none" only when frontend and API are cross-site and HTTPS is mandatory.
SFI_REFRESH_COOKIE_SAMESITE=lax
# Optional cookie domain, e.g. .example.com. Leave empty for host-only cookies.
SFI_REFRESH_COOKIE_DOMAIN=
