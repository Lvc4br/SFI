{
  "name": "sfi",
  "display_name": "Sistema Financeiro Integrado",
  "version": "0.2.0-dev",
  "status": "desktop-local-first-in-development",
  "platforms": [
    "windows-desktop-primary",
    "web-shared-ui-development"
  ],
  "product_type": "personal-finance-and-asset-management",
  "excluded_scope": [
    "financial-education",
    "courses",
    "lessons",
    "teaching-platform"
  ],
  "stack": {
    "desktop": "Tauri 2 + React + TypeScript + Vite",
    "backend": "Python + FastAPI packaged sidecar",
    "database": "SQLite local primary",
    "remote_sync": "Neon PostgreSQL optional opt-in",
    "documents": "private local application data directory"
  },
  "capabilities": {
    "offline_core_required": true,
    "remote_api_required": false,
    "ai_optional": true,
    "market_data_optional": true
  },
  "packaging": {
    "target": "Windows 10/11 x64",
    "installer": [
      "NSIS",
      "MSI"
    ],
    "runtime_dependencies_installed_by_app": true
  },
  "docker_required": false
}
